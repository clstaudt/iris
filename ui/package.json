{
  "name": "iris-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Electron UI shell for the Iris voice assistant",
  "author": "Christian Staudt",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "npm run build:electron && ELECTRON_RUN_AS_NODE= concurrently -k \"vite\" \"npm:dev:esbuild:watch\" \"wait-on tcp:127.0.0.1:5173 && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 ELECTRON_RUN_AS_NODE= electron .\"",
    "dev:esbuild:watch": "npm run build:electron -- --watch",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist-electron --out-extension:.js=.cjs",
    "build": "npm run build:electron && vite build",
    "preview": "vite preview",
    "e2e": "node e2e/run.mjs",
    "test:bridge": "node --test e2e/bridge.test.mjs",
    "test:wake-hint": "node --test e2e/wakehint.test.mjs",
    "test:shutter": "node --test e2e/shutter.test.mjs",
    "icon": "esbuild scripts/icon/render.ts --bundle --format=iife --outfile=dist-electron/icon-render.js && ELECTRON_RUN_AS_NODE= electron scripts/icon/make-icon.cjs",
    "dist:mac": "bash scripts/package-mac.sh"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "playwright-core": "^1.56.1",
    "svelte": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.24.2": true,
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "marked": "^18.0.14"
  },
  "build": {
    "appId": "dev.iris.assistant",
    "productName": "Iris",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/main.cjs",
      "dist-electron/preload.cjs",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../packaging/dist/iris-rpc",
        "to": "iris-rpc"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      }
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "artifactName": "Iris-${version}-macOS-${arch}.${ext}",
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true,
      "notarize": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Iris listens for your voice.",
        "NSCameraUsageDescription": "Iris looks through the camera when you ask it to."
      }
    },
    "dmg": {
      "format": "ULFO",
      "title": "Iris"
    }
  }
}
